//// Pooka sample used by the editor highlighter checks.

module demo

import pooka/http.{Request, Response}
import pooka/otp as otp

/// A tiny server used to exercise every capture in the highlighting queries.
class Server {
  let name: String = "example"
  var port: Int = 8080

  new(port: Int) {
    assert port > 0
  }

  be handle(request: Request) -> Response {
    match request.method {
      "GET" -> Response(200, "ok")
      _ -> Response(404, "missing")
    }
  }
}

actor Worker with lifecycle {
  be start() {
    loop {
      echo "tick"
      match True {
        True -> { break }
        False -> continue
      }
    }
  }
}

interface Store {
  get(key: String) -> String
}

enum Status { Ok, Error }

class Point(x: Int, y: Int)

sum(values: Int) -> Int {
  values |> echo
  0
}

